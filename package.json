{
  "name": "@kylobyte/keel",
  "version": "0.1.2",
  "type": "module",
  "description": "Opinionated Fastify 5 + Effect backend framework — Effect Schema as type provider, controllers as Effect services, tagged errors mapped to HTTP, Pino↔Effect logging, SSE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylobyte-dev/keel.git"
  },
  "homepage": "https://github.com/kylobyte-dev/keel#readme",
  "keywords": [
    "fastify",
    "effect",
    "effect-ts",
    "backend",
    "framework",
    "openapi",
    "sse"
  ],
  "packageManager": "pnpm@10.33.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./sse": {
      "types": "./dist/sse/index.d.ts",
      "default": "./dist/sse/index.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "default": "./dist/sql/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "default": "./dist/openapi/index.js"
    },
    "./tsconfig.main.json": "./tsconfig.main.json"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "tsconfig.main.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check-types": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "prepare": "rm -rf dist && tsc",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "@effect/sql": "0.48.6",
    "@effect/sql-pg": "0.49.7",
    "@fastify/error": "^4.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.6.1",
    "@scalar/fastify-api-reference": "^1.43.17",
    "drizzle-orm": "1.0.0-beta.22",
    "effect": "^3.20.0",
    "fastify": "^5.7.2",
    "fastify-plugin": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "snowyflake": "2.0.1"
  },
  "peerDependenciesMeta": {
    "@effect/sql": {
      "optional": true
    },
    "@effect/sql-pg": {
      "optional": true
    },
    "@fastify/helmet": {
      "optional": true
    },
    "@scalar/fastify-api-reference": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "helmet": {
      "optional": true
    },
    "snowyflake": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/sql": "0.48.6",
    "@effect/sql-pg": "0.49.7",
    "@fastify/error": "^4.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.6.1",
    "@scalar/fastify-api-reference": "^1.43.17",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.16.0",
    "drizzle-orm": "1.0.0-beta.22",
    "effect": "^3.20.0",
    "fastify": "^5.7.2",
    "fastify-plugin": "^5.1.0",
    "helmet": "^8.1.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.17.2",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "snowyflake": "2.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
